<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/new-post.css">
    <title>Document</title>
</head>
<body>
    <div id="newBlogContainer">
        <form action="/submit" method="POST">
            <textarea name="content" class="newBlogArea" rows="30" cols="100"><%= content %></textarea>
            <input type="text" name="blogName" placeholder="<%= title %>" class="blogName" value="<%= title %>" readonly>
            <input type="submit" value="Save" class="save">
        </form>
  </div>
</body>
</html>