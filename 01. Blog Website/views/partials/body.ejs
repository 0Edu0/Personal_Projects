<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="styles/body.css">
    <title>Document</title>
</head>
<body>
    <div class="body">
        <h1>Welcome to the blog website, created with Node, Express and EJS!</h1>
        <h2>Below you'll see a list for the created blogs:</h2>
        <ul>
            <% blogs.forEach(blog => { %>
            <a href="/blogsStorage/<%= blog.slug %>""><li><%= blog.title %></li></a>
            <% }) %>
        </ul>
    </div>
</body>
</html>